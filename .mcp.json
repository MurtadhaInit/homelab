{
  "mcpServers": {
    "flux-operator-mcp": {
      "command": "mise",
      "args": ["exec", "--", "flux-operator-mcp", "serve", "--read-only=false"]
    },
    "flux-schema-catalog": {
      "type": "http",
      "url": "https://schemas.fluxoperator.dev/mcp"
    },
    "grafana-mcp": {
      "command": "mise",
      "args": ["exec", "--", "uvx", "mcp-grafana"],
      "env": {
        "GRAFANA_URL": "https://grafana.k8s.murtadha.dev"
      }
    },
    "siderolabs-docs": {
      "type": "http",
      "url": "https://docs.siderolabs.com/mcp"
    }
  }
}
