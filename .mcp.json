{
  "mcpServers": {
    "flux-operator-mcp": {
      "command": "mise",
      "args": ["exec", "--", "flux-operator-mcp", "serve", "--read-only=false"]
    },
    "flux-schema-catalog": {
      "type": "http",
      "url": "https://schemas.fluxoperator.dev/mcp"
    },
    "grafana-mcp": {
      "command": "mise",
      "args": ["-E", "grafana-mcp", "exec", "--", "mcp-grafana"],
      "env": {
        "GRAFANA_URL": "https://grafana.k8s.murtadha.dev"
      }
    },
    "siderolabs-docs": {
      "type": "http",
      "url": "https://docs.siderolabs.com/mcp"
    },
    "dozzle": {
      "type": "streamable-http",
      "url": "https://dozzle.home.murtadha.dev/api/mcp"
    },
    "unifi": {
      "command": "mise",
      "args": ["-E", "unifi-mcp", "exec", "--", "unifi-mcp-server"],
      "env": {
        "UNIFI_API_TYPE": "local",
        "UNIFI_LOCAL_HOST": "10.20.30.1",
        "UNIFI_READ_ONLY": "true",
        "UNIFI_AUDIT_LOG_ENABLED": "false",
        "UNIFI_LOCAL_VERIFY_SSL": "false"
      }
    }
  }
}
